# Node Modules (यह फोल्डर इंटरनेट से दोबारा डाउनलोड हो जाता है, इसे पुश नहीं करना है)
node_modules/
backend/node_modules/
frontend/node_modules/

# Production builds (फ्रंटएंड का तैयार माल)
dist/
build/
.next/
out/

# Environment Variables (आपके सीक्रेट पासवर्ड और डेटाबेस की चाबियां)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs (सिस्टम की फालतू एरर फाइल्स)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System Files (विंडोज और एडिटर्स का अपना कचरा)
.vscode/
.idea/
.DS_Store
Thumbs.db
